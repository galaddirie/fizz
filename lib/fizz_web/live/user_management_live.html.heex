<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div id="user-management-page" class="space-y-8">
    <section
      id="user-management-hero"
      class="relative overflow-hidden rounded-box border border-base-300 bg-base-100 p-6"
    >
      <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top_right,oklch(70%_0.21_47.6/.16),transparent_52%)]">
      </div>

      <div class="relative">
        <h1 class="text-2xl font-semibold tracking-tight">WorkOS User Management</h1>
        <p class="mt-2 max-w-2xl text-sm text-base-content/70">
          Run a full identity administration surface directly inside this LiveView. Widgets stay in sync
          with server-managed organization context and token lifecycle.
        </p>
      </div>
    </section>

    <section
      id="user-management-context"
      class="rounded-box border border-base-300 bg-base-100 p-6"
    >
      <div class="mb-4 flex flex-col items-start justify-between gap-3 sm:flex-row sm:items-center">
        <div>
          <h2 class="text-lg font-semibold tracking-tight">Context</h2>
          <p class="text-sm text-base-content/70">
            Select an organization and refresh the widget session token when needed.
          </p>
        </div>

        <.button id="user-management-refresh-token-button" phx-click="refresh_widget_token">
          Refresh Widget Token
        </.button>
      </div>

      <dl class="mb-5 grid gap-4 sm:grid-cols-2">
        <div
          id="user-management-local-user-id"
          class="rounded-box border border-base-300 bg-base-200/50 p-4"
        >
          <dt class="text-xs uppercase tracking-wide text-base-content/60">Local user ID</dt>
          <dd class="mt-2 font-mono text-sm">{@current_scope.user.id}</dd>
        </div>

        <div
          id="user-management-workos-user-id"
          class="rounded-box border border-base-300 bg-base-200/50 p-4"
        >
          <dt class="text-xs uppercase tracking-wide text-base-content/60">WorkOS user ID</dt>
          <dd class="mt-2 font-mono text-sm">{@workos_user_id || "Not linked"}</dd>
        </div>
      </dl>

      <.form
        :if={@organization_options != []}
        for={@org_form}
        id="user-management-organization-form"
        phx-change="change_organization"
        class="max-w-xl"
      >
        <.input
          field={@org_form[:organization_id]}
          type="select"
          label="Organization"
          options={@organization_options}
        />
      </.form>

      <p
        :if={@organization_options == []}
        id="user-management-no-organization"
        class="rounded-box border border-warning/40 bg-warning/10 p-3 text-sm"
      >
        No active WorkOS organization memberships were found for this account.
      </p>

      <p
        :if={@widget_error}
        id="user-management-widget-error"
        class="mt-4 rounded-box border border-error/40 bg-error/10 p-3 text-sm"
      >
        {widget_error_message(@widget_error)}
      </p>
    </section>

    <section :if={@widget_token} id="user-management-widgets" class="space-y-4">
      <div class="grid gap-4 lg:grid-cols-2">
        <div
          :for={widget <- @widget_configs}
          id={"user-management-#{widget.dom_id}-widget-#{@selected_organization_id}"}
          phx-hook="WorkOSReactWidget"
          phx-update="ignore"
          data-widget={widget.widget_name}
          data-auth-token={@widget_token}
          class="group rounded-box border border-base-300 bg-base-100 p-4 transition duration-300 hover:border-primary/40 hover:shadow-lg hover:shadow-primary/5"
        >
          <div class="mb-3 border-b border-base-200 pb-3">
            <h3 class="text-sm font-semibold tracking-wide">{widget.title}</h3>
            <p class="mt-1 text-xs text-base-content/70">{widget.description}</p>
          </div>
          <div class="rounded-box border border-dashed border-base-300 bg-base-200/40 p-4 text-sm text-base-content/70">
            Loading {widget.title} widget…
          </div>
        </div>
      </div>
    </section>
  </div>
</Layouts.app>

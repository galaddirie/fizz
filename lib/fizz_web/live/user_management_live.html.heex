<Layouts.app flash={@flash} current_scope={@current_scope} current_path="/settings/">
  <:page_header>
    <div class="w-full space-y-6">
      <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
        <div class="space-y-3">
          <p class="text-xs font-semibold uppercase tracking-[0.3em] text-muted">Settings</p>
          <h1 class="text-3xl font-semibold tracking-tight text-base-content">Account</h1>
          <p class="max-w-2xl text-sm text-muted">
            Manage your profile, security, and organization settings.
          </p>
        </div>
      </div>
    </div>
  </:page_header>

  <div id="user-management-page" class="flex flex-col gap-6 lg:flex-row">
    <%!-- Sidebar --%>
    <aside class="w-full shrink-0 lg:w-56">
      <nav class="flex flex-row gap-1 overflow-x-auto lg:flex-col">
        <%!-- Account section --%>
        <span class="hidden px-3 pb-1 text-xs font-semibold uppercase tracking-wider text-muted lg:block">
          Account
        </span>
        <button
          :for={tab <- @user_tabs}
          id={"settings-tab-#{tab.id}"}
          phx-click="switch_tab"
          phx-value-tab={tab.id}
          class={[
            "flex items-center gap-3 rounded-box px-3 py-2.5 text-left text-sm font-medium transition-colors whitespace-nowrap",
            tab.id == @active_tab && "bg-primary/10 text-primary",
            tab.id != @active_tab &&
              "text-base-content/70 hover:bg-base-200 hover:text-base-content"
          ]}
        >
          <.icon name={tab.icon} class="size-5 shrink-0" />
          <span>{tab.title}</span>
        </button>

        <%!-- Divider --%>
        <div class="hidden my-3 border-t border-base-200 lg:block"></div>

        <%!-- Organization section --%>
        <span class="hidden px-3 pb-1 text-xs font-semibold uppercase tracking-wider text-muted lg:block">
          Organization
        </span>
        <button
          :for={tab <- @org_tabs}
          id={"settings-tab-#{tab.id}"}
          phx-click="switch_tab"
          phx-value-tab={tab.id}
          class={[
            "flex items-center gap-3 rounded-box px-3 py-2.5 text-left text-sm font-medium transition-colors whitespace-nowrap",
            tab.id == @active_tab && "bg-primary/10 text-primary",
            tab.id != @active_tab &&
              "text-base-content/70 hover:bg-base-200 hover:text-base-content"
          ]}
        >
          <.icon name={tab.icon} class="size-5 shrink-0" />
          <span>{tab.title}</span>
        </button>
      </nav>

      <%!-- Org selector --%>
      <div class="mt-4 border-t border-base-200 pt-4 hidden lg:block">
        <.form
          for={@org_form}
          id="user-management-organization-form"
          phx-change="change_organization"
        >
          <.input
            field={@org_form[:organization_id]}
            id="user-management-organization-select-desktop"
            type="select"
            label="Organization"
            options={@organization_options}
          />
        </.form>
        <button
          phx-click="open_create_org_modal"
          class="btn btn-ghost btn-sm mt-2 w-full gap-2 text-base-content/70"
        >
          <.icon name="hero-plus" class="size-4" />
          <span>New organization</span>
        </button>
      </div>
    </aside>

    <%!-- Main content --%>
    <div class="min-w-0 flex-1">
      <%!-- Mobile org selector --%>
      <div :if={length(@organization_options) > 0} class="mb-4 lg:hidden">
        <.form
          for={@org_form}
          id="user-management-organization-form-mobile"
          phx-change="change_organization"
        >
          <.input
            field={@org_form[:organization_id]}
            id="user-management-organization-select-mobile"
            type="select"
            label="Organization"
            options={@organization_options}
          />
        </.form>
        <button
          phx-click="open_create_org_modal"
          class="btn btn-ghost btn-sm mt-2 gap-2 text-base-content/70"
        >
          <.icon name="hero-plus" class="size-4" />
          <span>New organization</span>
        </button>
      </div>

      <p
        :if={@organization_options == []}
        id="user-management-no-organization"
        class="rounded-box border border-warning/40 bg-warning/10 p-4 text-sm"
      >
        Unable to provision organization settings. Please try again later.
      </p>

      <div id="user-management-context">
        <%= if @active_tab == "api-keys" do %>
          <div id="user-management-credentials-section" class="space-y-5">
            <%!-- Header --%>
            <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
              <div>
                <h2 class="text-lg font-semibold tracking-tight">Credentials</h2>
                <p class="mt-1 text-sm text-muted">
                  Securely stored in WorkOS Vault. Scoped to your selected organization.
                </p>
              </div>
              <button
                id="open-create-credential-modal"
                phx-click="open_create_credential_modal"
                class={[
                  "btn btn-primary btn-sm gap-2 shrink-0",
                  is_nil(@selected_organization_id) && "btn-disabled"
                ]}
                disabled={is_nil(@selected_organization_id)}
              >
                <.icon name="hero-plus" class="size-4" />
                <span>Add credential</span>
              </button>
            </div>

            <p
              :if={@credentials_error}
              id="user-management-credentials-error"
              class="rounded-box border border-error/40 bg-error/10 p-4 text-sm"
            >
              {credential_error_message(@credentials_error)}
            </p>

            <%!-- Credential table --%>
            <div
              id="user-management-credentials-list"
              class="overflow-visible rounded-box border border-base-300 bg-base-100"
            >
              <%!-- Empty state --%>
              <div
                :if={@credentials == [] && !@credentials_error}
                id="user-management-credentials-empty"
                class="flex flex-col items-center justify-center px-6 py-16 text-center"
              >
                <div class="flex size-12 items-center justify-center rounded-full bg-base-200">
                  <.icon name="hero-key" class="size-6 text-muted" />
                </div>
                <p class="mt-4 text-sm font-medium text-base-content">No credentials yet</p>
                <p class="mt-1 max-w-xs text-xs text-muted">
                  Add your first API credential to connect a provider to this organization.
                </p>
                <button
                  :if={!is_nil(@selected_organization_id)}
                  phx-click="open_create_credential_modal"
                  class="btn btn-primary btn-sm mt-5 gap-2"
                >
                  <.icon name="hero-plus" class="size-4" />
                  <span>Add credential</span>
                </button>
              </div>

              <%!-- Table rows --%>
              <div :if={@credentials != []}>
                <%!-- Table header --%>
                <div class="hidden border-b border-base-300 bg-base-200/50 px-4 py-2.5 text-xs font-medium uppercase tracking-wider text-muted sm:grid sm:grid-cols-[minmax(0,1fr)_120px_100px_140px] sm:gap-4">
                  <span>Provider</span>
                  <span>Secret</span>
                  <span>Last used</span>
                  <span class="text-right">Actions</span>
                </div>

                <div
                  :for={credential <- @credentials}
                  id={"credential-#{credential.id}"}
                  class="group flex flex-col gap-3 border-b border-base-300 px-4 py-3 transition-colors last:border-b-0 hover:bg-base-200/30 sm:grid sm:grid-cols-[minmax(0,1fr)_120px_100px_140px] sm:items-center sm:gap-4"
                >
                  <%!-- Provider info --%>
                  <div class="flex items-center gap-3">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-lg border border-base-300 bg-base-200/60">
                      <%= if logo_path = provider_logo_path(@provider_catalog, credential.provider) do %>
                        <img
                          src={logo_path}
                          alt={"#{credential.provider_label} logo"}
                          class="size-5 rounded-sm object-contain"
                        />
                      <% else %>
                        <.icon name="hero-key" class="size-4 text-muted" />
                      <% end %>
                    </div>
                    <div class="min-w-0">
                      <p class="truncate text-sm font-medium text-base-content">
                        {credential.provider_label}
                      </p>
                      <p class="truncate text-xs text-muted">
                        {credential.provider_custom_name || credential.provider}
                      </p>
                    </div>
                  </div>

                  <%!-- Secret --%>
                  <div class="text-xs text-muted">
                    <span class="font-mono tracking-wide">••••••••</span>
                  </div>

                  <%!-- Last used --%>
                  <div class="text-xs text-muted">
                    {credential.last_used_at || "Never"}
                  </div>

                  <%!-- Actions --%>
                  <div class="relative flex items-center justify-end">
                    <div
                      id={"credential-actions-#{credential.id}"}
                      class="dropdown dropdown-end"
                    >
                      <button
                        type="button"
                        tabindex="0"
                        class="btn btn-ghost btn-sm btn-square text-base-content/60 transition-colors hover:text-base-content focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/30"
                      >
                        <span class="sr-only">Open credential actions</span>
                        <.icon name="hero-ellipsis-horizontal" class="size-5" />
                      </button>

                      <ul
                        tabindex="0"
                        class="menu dropdown-content z-[20] mt-1 w-48 rounded-box border border-base-300 bg-base-100 p-2 shadow-xl shadow-base-content/10"
                      >
                        <li>
                          <button
                            id={"rotate-credential-#{credential.id}"}
                            phx-click="open_rotate_credential_modal"
                            phx-value-credential_id={credential.id}
                            class="flex items-center gap-2 px-3 py-2.5 text-sm"
                          >
                            <.icon name="hero-pencil-square" class="size-4 shrink-0" />
                            <span>Edit credential</span>
                          </button>
                        </li>
                        <li>
                          <button
                            id={"delete-credential-#{credential.id}"}
                            phx-click="open_delete_credential_modal"
                            phx-value-credential_id={credential.id}
                            class="flex items-center gap-2 px-3 py-2.5 text-sm text-error hover:bg-error/10"
                          >
                            <.icon name="hero-trash" class="size-4 shrink-0" />
                            <span>Delete credential</span>
                          </button>
                        </li>
                      </ul>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% else %>
          <p
            :if={@widget_error && @organization_options != []}
            id="user-management-widget-error"
            class="rounded-box border border-error/40 bg-error/10 p-4 text-sm"
          >
            {widget_error_message(@widget_error)}
          </p>

          <%= if @widget_token do %>
            <% tab = active_tab_config(@user_tabs ++ @org_tabs, @active_tab) %>
            <div
              id={"settings-widget-#{tab.id}-#{@selected_organization_id}"}
              phx-hook="WorkOSReactWidget"
              phx-update="ignore"
              data-widget={tab.widget_name}
              data-auth-token={@widget_token}
              class="rounded-box border border-base-300 bg-base-100 p-6"
            >
              <div class="flex items-center justify-center py-12 text-sm text-base-content/50">
                Loading…
              </div>
            </div>

            <%!-- Compatibility anchors for test selectors --%>
            <div class="hidden">
              <div
                id={"user-management-users-management-widget-#{@selected_organization_id}"}
                data-widget="users-management"
                data-auth-token={@widget_token}
              >
              </div>
              <div
                id={"user-management-organization-switcher-widget-#{@selected_organization_id}"}
                data-widget="organization-switcher"
                data-auth-token={@widget_token}
              >
              </div>
              <div
                id={"user-management-user-profile-widget-#{@selected_organization_id}"}
                data-widget="user-profile"
                data-auth-token={@widget_token}
              >
              </div>
              <div
                id={"user-management-user-security-widget-#{@selected_organization_id}"}
                data-widget="user-security"
                data-auth-token={@widget_token}
              >
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <%!-- Create Organization Modal --%>
  <div
    :if={@show_create_org_modal}
    id="create-org-modal"
    class="modal modal-open"
    phx-window-keydown="close_create_org_modal"
    phx-key="Escape"
  >
    <div class="modal-backdrop" phx-click="close_create_org_modal"></div>
    <div class="modal-box">
      <h3 class="text-lg font-bold">Create Organization</h3>
      <p class="mt-2 text-sm text-base-content/70">
        Create a new organization to collaborate with your team.
      </p>
      <.form
        for={@create_org_form}
        id="create-org-form"
        phx-change="validate_create_org"
        phx-submit="create_organization"
        class="mt-4"
      >
        <.input
          field={@create_org_form[:name]}
          type="text"
          label="Organization name"
          placeholder="My Organization"
          phx-debounce="300"
        />
        <div class="modal-action">
          <button type="button" class="btn" phx-click="close_create_org_modal">
            Cancel
          </button>
          <button type="submit" class="btn btn-primary">
            Create
          </button>
        </div>
      </.form>
    </div>
  </div>

  <%!-- Create Credential Modal (2-step) --%>
  <div
    :if={@show_create_credential_modal}
    id="create-credential-modal"
    class="modal modal-open"
    phx-window-keydown="close_create_credential_modal"
    phx-key="Escape"
  >
    <div class="modal-backdrop" phx-click="close_create_credential_modal"></div>
    <div class="modal-box max-w-md p-0">
      <%= if @credential_modal_step == :select_provider do %>
        <%!-- Step 1: Provider selector (command palette style) --%>
        <div id="credential-step-select" class="flex flex-col">
          <%!-- Header with search --%>
          <div class="border-b border-base-300 px-4 pt-4 pb-3">
            <div class="flex items-center justify-between">
              <h3 class="text-base font-semibold tracking-tight">Add Credential</h3>
              <button
                type="button"
                phx-click="close_create_credential_modal"
                class="rounded-lg p-1 text-muted transition-colors hover:bg-base-200 hover:text-base-content"
              >
                <.icon name="hero-x-mark" class="size-5" />
              </button>
            </div>
            <div class="relative mt-3">
              <.icon
                name="hero-magnifying-glass"
                class="pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-muted"
              />
              <form id="provider-search-form" phx-change="search_providers">
                <input
                  id="provider-search-input"
                  name="query"
                  type="text"
                  placeholder="Search providers..."
                  value={@provider_search_query}
                  phx-debounce="100"
                  class="w-full rounded-lg border border-base-300 bg-base-200/50 py-2 pl-9 pr-3 text-sm text-base-content placeholder:text-muted focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
                  autofocus
                  autocomplete="off"
                />
              </form>
            </div>
          </div>

          <%!-- Provider list --%>
          <div class="max-h-72 overflow-y-auto px-2 py-2">
            <%= if @filtered_providers == [] do %>
              <div class="flex flex-col items-center justify-center py-8 text-center">
                <.icon name="hero-magnifying-glass" class="size-6 text-muted" />
                <p class="mt-2 text-sm text-muted">No providers match your search</p>
              </div>
            <% else %>
              <div class="space-y-0.5">
                <button
                  :for={provider <- @filtered_providers}
                  id={"select-provider-#{provider.id}"}
                  type="button"
                  phx-click="select_provider"
                  phx-value-provider_id={provider.id}
                  class="flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-left transition-colors hover:bg-base-200"
                >
                  <div class="flex size-8 shrink-0 items-center justify-center rounded-lg border border-base-300 bg-base-200/60">
                    <%= if provider.logo_path do %>
                      <img
                        src={provider.logo_path}
                        alt={"#{provider.label} logo"}
                        class="size-5 rounded-sm object-contain"
                      />
                    <% else %>
                      <.icon name="hero-cog-6-tooth" class="size-4 text-muted" />
                    <% end %>
                  </div>
                  <div class="min-w-0 flex-1">
                    <p class="text-sm font-medium text-base-content">{provider.label}</p>
                    <p class="text-xs text-muted">API Key</p>
                  </div>
                  <.icon
                    name="hero-chevron-right"
                    class="size-4 shrink-0 text-base-content/30"
                  />
                </button>
              </div>
            <% end %>
          </div>
        </div>
      <% else %>
        <%!-- Step 2: Configure credential --%>
        <div id="credential-step-configure" class="flex flex-col">
          <%!-- Header with back button --%>
          <div class="border-b border-base-300 px-4 pt-4 pb-3">
            <div class="flex items-center justify-between">
              <button
                type="button"
                phx-click="credential_modal_back"
                class="flex items-center gap-1 rounded-lg py-1 pr-2 text-sm font-medium text-muted transition-colors hover:text-base-content"
              >
                <.icon name="hero-arrow-left" class="size-4" />
                <span>Back</span>
              </button>
              <button
                type="button"
                phx-click="close_create_credential_modal"
                class="rounded-lg p-1 text-muted transition-colors hover:bg-base-200 hover:text-base-content"
              >
                <.icon name="hero-x-mark" class="size-5" />
              </button>
            </div>

            <%!-- Selected provider identity --%>
            <div :if={@selected_provider} class="mt-3 flex items-center gap-3">
              <div class="flex size-10 items-center justify-center rounded-lg border border-base-300 bg-base-200/60">
                <%= if @selected_provider.logo_path do %>
                  <img
                    src={@selected_provider.logo_path}
                    alt={"#{@selected_provider.label} logo"}
                    class="size-6 rounded-sm object-contain"
                  />
                <% else %>
                  <.icon name="hero-cog-6-tooth" class="size-5 text-muted" />
                <% end %>
              </div>
              <div>
                <p class="text-sm font-semibold text-base-content">
                  {@selected_provider.label}
                </p>
                <p class="text-xs text-muted">API Key credential</p>
              </div>
            </div>
          </div>

          <%!-- Configure form --%>
          <div class="px-4 pt-4 pb-5">
            <.form
              for={@credential_form}
              id="create-credential-form"
              phx-change="validate_credential"
              phx-submit="create_credential"
              class="space-y-4"
            >
              <input
                type="hidden"
                name={@credential_form[:provider].name}
                value={@credential_form[:provider].value}
              />
              <.input
                field={@credential_form[:provider_label]}
                type="text"
                label="Display label"
              />
              <.input
                :if={@selected_provider && @selected_provider.custom}
                field={@credential_form[:provider_custom_name]}
                type="text"
                label="Custom provider name"
                placeholder="e.g. Acme AI"
              />
              <.input
                :for={credential_field <- credential_fields(@credential_form[:provider].value)}
                id={credential_field_id(@credential_form, credential_field)}
                name={credential_field_name(@credential_form, credential_field)}
                value={credential_field_value(@credential_form, credential_field)}
                type={credential_field.input_type}
                label={credential_field.label}
                placeholder={credential_field.placeholder}
                autocomplete={credential_field.autocomplete}
                required={credential_field.required}
              />
              <div class="flex items-center justify-end gap-2 pt-2">
                <button
                  type="button"
                  class="rounded-lg px-4 py-2 text-sm font-medium text-muted transition-colors hover:bg-base-200 hover:text-base-content"
                  phx-click="close_create_credential_modal"
                >
                  Cancel
                </button>
                <button type="submit" class="btn btn-primary btn-sm">
                  Save credential
                </button>
              </div>
            </.form>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <%!-- Rotate Credential Modal --%>
  <div
    :if={@show_rotate_credential_modal}
    id="rotate-credential-modal"
    class="modal modal-open"
    phx-window-keydown="close_rotate_credential_modal"
    phx-key="Escape"
  >
    <div class="modal-backdrop" phx-click="close_rotate_credential_modal"></div>
    <div class="modal-box max-w-md p-0">
      <% selected_credential = Enum.find(@credentials, &(&1.id == @selected_credential_id)) %>
      <div id="credential-step-edit" class="flex flex-col">
        <div class="border-b border-base-300 px-4 pt-4 pb-3">
          <div class="flex items-center justify-between">
            <h3 class="text-base font-semibold tracking-tight">Edit Credential</h3>
            <button
              type="button"
              phx-click="close_rotate_credential_modal"
              class="rounded-lg p-1 text-muted transition-colors hover:bg-base-200 hover:text-base-content"
            >
              <.icon name="hero-x-mark" class="size-5" />
            </button>
          </div>

          <div :if={selected_credential} class="mt-3 flex items-center gap-3">
            <div class="flex size-10 items-center justify-center rounded-lg border border-base-300 bg-base-200/60">
              <%= if logo_path = provider_logo_path(@provider_catalog, selected_credential.provider) do %>
                <img
                  src={logo_path}
                  alt={"#{selected_credential.provider_label} logo"}
                  class="size-6 rounded-sm object-contain"
                />
              <% else %>
                <.icon name="hero-cog-6-tooth" class="size-5 text-muted" />
              <% end %>
            </div>
            <div>
              <p class="text-sm font-semibold text-base-content">
                {selected_credential.provider_label}
              </p>
              <p class="text-xs text-muted">
                {selected_credential.provider_custom_name || selected_credential.provider}
              </p>
            </div>
          </div>
        </div>

        <div class="px-4 pt-4 pb-5">
          <.form
            for={@rotate_credential_form}
            id="rotate-credential-form"
            phx-change="validate_rotate_credential"
            phx-submit="rotate_credential"
            class="space-y-4"
          >
            <.input
              field={@rotate_credential_form[:provider_label]}
              type="text"
              label="Display label"
            />
            <.input
              field={@rotate_credential_form[:provider_custom_name]}
              type="text"
              label="Custom provider name (optional)"
            />
            <.input
              :for={credential_field <- credential_fields_for(selected_credential)}
              id={credential_field_id(@rotate_credential_form, credential_field)}
              name={credential_field_name(@rotate_credential_form, credential_field)}
              value={credential_field_value(@rotate_credential_form, credential_field)}
              type={credential_field.input_type}
              label={"New #{credential_field.label}"}
              placeholder={credential_field.placeholder}
              autocomplete={credential_field.autocomplete}
              required={credential_field.required}
            />
            <div class="flex items-center justify-end gap-2 pt-2">
              <button
                type="button"
                class="rounded-lg px-4 py-2 text-sm font-medium text-muted transition-colors hover:bg-base-200 hover:text-base-content"
                phx-click="close_rotate_credential_modal"
              >
                Cancel
              </button>
              <button type="submit" class="btn btn-primary btn-sm">
                Save changes
              </button>
            </div>
          </.form>
        </div>
      </div>
    </div>
  </div>

  <%!-- Delete Credential Modal --%>
  <div
    :if={@show_delete_credential_modal}
    id="delete-credential-modal"
    class="modal modal-open"
    phx-window-keydown="close_delete_credential_modal"
    phx-key="Escape"
  >
    <div class="modal-backdrop" phx-click="close_delete_credential_modal"></div>
    <div class="modal-box max-w-sm p-0">
      <div class="px-5 pt-5 pb-4">
        <div class="flex items-start gap-3">
          <div class="flex size-10 shrink-0 items-center justify-center rounded-full bg-error/10">
            <.icon name="hero-exclamation-triangle" class="size-5 text-error" />
          </div>
          <div>
            <h3 class="text-base font-semibold text-base-content">Delete credential</h3>
            <p class="mt-1 text-sm text-muted">
              This permanently deletes the Vault object and cannot be undone.
            </p>
          </div>
        </div>
      </div>
      <div class="flex items-center justify-end gap-2 border-t border-base-300 px-5 py-3">
        <button
          type="button"
          class="rounded-lg px-4 py-2 text-sm font-medium text-muted transition-colors hover:bg-base-200 hover:text-base-content"
          phx-click="close_delete_credential_modal"
        >
          Cancel
        </button>
        <button
          type="button"
          class="btn btn-error btn-sm"
          phx-click="delete_credential"
        >
          Delete
        </button>
      </div>
    </div>
  </div>
</Layouts.app>

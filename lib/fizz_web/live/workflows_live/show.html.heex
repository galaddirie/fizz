<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  current_path={~p"/projects/#{@project_id}"}
>
  <:page_header>
    <div class="w-full space-y-6">
      <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
        <div class="space-y-3">
          <.link
            navigate={~p"/projects/#{@project_id}/workflows"}
            class="inline-flex items-center gap-2 text-sm text-muted hover:text-base-content transition-colors"
          >
            <.icon name="hero-arrow-left" class="size-4" /> Back to workflows
          </.link>
          <p class="text-xs font-semibold uppercase tracking-[0.3em] text-muted">Workflow</p>
          <h1 class="text-3xl font-semibold tracking-tight text-base-content">
            {if @definition, do: @definition.name, else: "Loading..."}
          </h1>
          <p
            :if={@definition && @definition.description && @definition.description != ""}
            class="max-w-2xl text-sm text-muted"
          >
            {@definition.description}
          </p>
        </div>

        <div :if={@definition} class="flex gap-3">
          <.link
            navigate={~p"/projects/#{@project_id}/workflows/#{@definition_id}/edit"}
            class="btn btn-sm btn-primary gap-2"
          >
            <.icon name="hero-pencil-square" class="size-4" />
            <span>Edit Workflow</span>
          </.link>
        </div>
      </div>
    </div>
  </:page_header>

  <div :if={@definition} class="space-y-8">
    <%!-- Configuration Summary Cards --%>
    <section class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <%!-- Version Status Card --%>
      <div class="card border border-base-300 rounded-2xl bg-base-100 p-5 shadow-sm ring-1 ring-base-300/70">
        <div class="flex items-center gap-3">
          <div class="rounded-xl bg-primary/10 p-2.5">
            <.icon name="hero-document-text" class="size-5 text-primary" />
          </div>
          <div>
            <p class="text-xs font-medium uppercase tracking-wider text-muted">Version</p>
            <%= if @latest_version do %>
              <% {label, badge_class} = version_status_badge(@latest_version.status) %>
              <div class="mt-1 flex items-center gap-2">
                <span class="text-lg font-semibold text-base-content">
                  v{@latest_version.version}
                </span>
                <span class={["badge badge-sm", badge_class]}>{label}</span>
              </div>
            <% else %>
              <p class="mt-1 text-sm text-base-content/60">No versions</p>
            <% end %>
          </div>
        </div>
      </div>

      <%!-- Total Runs Card --%>
      <div class="card border border-base-300 rounded-2xl bg-base-100 p-5 shadow-sm ring-1 ring-base-300/70">
        <div class="flex items-center gap-3">
          <div class="rounded-xl bg-info/10 p-2.5">
            <.icon name="hero-play" class="size-5 text-info" />
          </div>
          <div>
            <p class="text-xs font-medium uppercase tracking-wider text-muted">Total Runs</p>
            <p class="mt-1 text-lg font-semibold text-base-content">
              {@run_counts[:total] || 0}
            </p>
          </div>
        </div>
      </div>

      <%!-- Success Rate Card --%>
      <div class="card border border-base-300 rounded-2xl bg-base-100 p-5 shadow-sm ring-1 ring-base-300/70">
        <div class="flex items-center gap-3">
          <div class="rounded-xl bg-success/10 p-2.5">
            <.icon name="hero-check-circle" class="size-5 text-success" />
          </div>
          <div>
            <p class="text-xs font-medium uppercase tracking-wider text-muted">Completed</p>
            <p class="mt-1 text-lg font-semibold text-base-content">
              {@run_counts[:completed] || 0}
            </p>
          </div>
        </div>
      </div>

      <%!-- Failed Card --%>
      <div class="card border border-base-300 rounded-2xl bg-base-100 p-5 shadow-sm ring-1 ring-base-300/70">
        <div class="flex items-center gap-3">
          <div class="rounded-xl bg-error/10 p-2.5">
            <.icon name="hero-exclamation-triangle" class="size-5 text-error" />
          </div>
          <div>
            <p class="text-xs font-medium uppercase tracking-wider text-muted">Failed</p>
            <p class="mt-1 text-lg font-semibold text-base-content">
              {@run_counts[:failed] || 0}
            </p>
          </div>
        </div>
      </div>
    </section>

    <%!-- Details Section --%>
    <section class="grid grid-cols-1 gap-6 lg:grid-cols-3">
      <%!-- Configuration Details --%>
      <div class="lg:col-span-1 space-y-6">
        <%!-- Workflow Info --%>
        <div class="card border border-base-300 rounded-2xl bg-base-100 shadow-sm ring-1 ring-base-300/70">
          <div class="border-b border-base-200 px-5 py-3">
            <h2 class="text-sm font-semibold text-base-content">Details</h2>
          </div>
          <div class="divide-y divide-base-200">
            <div class="flex items-center justify-between px-5 py-3">
              <span class="text-xs text-muted">ID</span>
              <span class="font-mono text-xs text-base-content/70">
                {short_id(@definition.id)}
              </span>
            </div>
            <div class="flex items-center justify-between px-5 py-3">
              <span class="text-xs text-muted">Created</span>
              <span class="text-xs text-base-content/70">
                {formatted_date(@definition.inserted_at)}
              </span>
            </div>
            <div class="flex items-center justify-between px-5 py-3">
              <span class="text-xs text-muted">Updated</span>
              <span class="text-xs text-base-content/70">
                {formatted_date(@definition.updated_at)}
              </span>
            </div>
            <%= if @latest_version && @latest_version.published_at do %>
              <div class="flex items-center justify-between px-5 py-3">
                <span class="text-xs text-muted">Published</span>
                <span class="text-xs text-base-content/70">
                  {formatted_date(@latest_version.published_at)}
                </span>
              </div>
            <% end %>
          </div>
        </div>

        <%!-- Steps Summary --%>
        <div class="card border border-base-300 rounded-2xl bg-base-100 shadow-sm ring-1 ring-base-300/70">
          <div class="border-b border-base-200 px-5 py-3">
            <h2 class="text-sm font-semibold text-base-content">
              Steps
              <span :if={@latest_version} class="text-muted font-normal">
                ({length(@latest_version.steps)})
              </span>
            </h2>
          </div>
          <%= if @step_summary == [] do %>
            <div class="px-5 py-6 text-center">
              <p class="text-xs text-muted">No steps configured</p>
            </div>
          <% else %>
            <div class="divide-y divide-base-200">
              <%= for {type_id, count} <- @step_summary do %>
                <div class="flex items-center justify-between px-5 py-2.5">
                  <span class="text-xs text-base-content">{step_type_label(type_id)}</span>
                  <span class="badge badge-sm badge-ghost">{count}</span>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>

        <%!-- Version History --%>
        <div class="card border border-base-300 rounded-2xl bg-base-100 shadow-sm ring-1 ring-base-300/70">
          <div class="border-b border-base-200 px-5 py-3">
            <h2 class="text-sm font-semibold text-base-content">Versions</h2>
          </div>
          <%= if @definition.versions == [] do %>
            <div class="px-5 py-6 text-center">
              <p class="text-xs text-muted">No versions yet</p>
            </div>
          <% else %>
            <div class="divide-y divide-base-200">
              <%= for version <- @definition.versions do %>
                <div class="flex items-center justify-between px-5 py-2.5">
                  <div class="flex items-center gap-2">
                    <span class="text-xs font-medium text-base-content">v{version.version}</span>
                    <% {label, badge_class} = version_status_badge(version.status) %>
                    <span class={["badge badge-xs", badge_class]}>{label}</span>
                  </div>
                  <span class="text-[11px] text-muted">
                    {formatted_date(version.updated_at)}
                  </span>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

      <%!-- Execution History --%>
      <div class="lg:col-span-2">
        <div class="card border border-base-300 rounded-2xl bg-base-100 shadow-sm ring-1 ring-base-300/70 overflow-hidden">
          <div class="border-b border-base-200 px-5 py-3 flex items-center justify-between">
            <h2 class="text-sm font-semibold text-base-content">Execution History</h2>
            <div
              :if={@run_counts[:running] && @run_counts[:running] > 0}
              class="flex items-center gap-1.5"
            >
              <span class="size-2 rounded-full bg-info animate-pulse"></span>
              <span class="text-xs text-info">{@run_counts[:running]} active</span>
            </div>
          </div>
          <div class="p-3">
            <.data_table
              id="workflow-runs"
              rows={@streams.runs}
              rows_empty?={@runs_empty?}
              tbody_class="divide-y divide-base-200"
              row_click={
                fn {_dom_id, run} ->
                  JS.navigate(
                    ~p"/projects/#{@project_id}/workflows/#{@definition_id}/runs/#{run.id}"
                  )
                end
              }
              row_class="cursor-pointer hover:bg-neutral/10"
            >
              <:col :let={run} label="Run">
                <div class="flex items-center gap-3">
                  <span class={["size-2.5 shrink-0 rounded-full", run_status_dot(run.status)]}>
                  </span>
                  <div>
                    <p class="font-mono text-xs text-base-content">{short_id(run.id)}</p>
                    <p class="text-[11px] text-muted mt-0.5">
                      {formatted_timestamp(run.inserted_at)}
                    </p>
                  </div>
                </div>
              </:col>

              <:col :let={run} label="Status" width="20%">
                <% {label, badge_class} = run_status_badge(run.status) %>
                <span class={["badge badge-sm", badge_class]}>{label}</span>
              </:col>

              <:col :let={run} label="Duration" width="15%">
                <span class="text-xs text-base-content/70">{run_duration(run)}</span>
              </:col>

              <:col :let={_run} label="" width="5%" align="center">
                <.icon name="hero-chevron-right" class="size-4 text-base-content/30" />
              </:col>

              <:empty_state>
                <div class="flex flex-col items-center justify-center gap-3 py-10 text-base-content/70">
                  <div class="rounded-full bg-base-200 p-3">
                    <.icon name="hero-clock" class="size-6" />
                  </div>
                  <div class="space-y-1 text-center">
                    <p class="text-sm font-semibold text-base-content">No executions yet</p>
                    <p class="text-xs">Runs will appear here once the workflow is triggered.</p>
                  </div>
                </div>
              </:empty_state>
            </.data_table>
          </div>
        </div>
      </div>
    </section>

    <%!-- Raw Debug JSON --%>
    <section>
      <details class="group">
        <summary class="cursor-pointer list-none flex items-center gap-2 text-xs text-muted hover:text-base-content transition-colors py-2">
          <.icon
            name="hero-chevron-right"
            class="size-3 transition-transform group-open:rotate-90"
          /> Raw JSON (debug)
        </summary>
        <div class="mt-2 card border border-base-300 rounded-2xl bg-base-100 shadow-sm ring-1 ring-base-300/70 overflow-hidden">
          <div class="p-4">
            <pre
              id="debug-json"
              class="text-xs text-base-content/70 whitespace-pre-wrap break-all font-mono bg-base-200/50 rounded-lg p-4 max-h-[600px] overflow-auto select-all"
            ><%= debug_json(@definition, @latest_version) %></pre>
          </div>
        </div>
      </details>
    </section>
  </div>
</Layouts.app>

<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  current_path={~p"/projects/#{@project_id}/sprites"}
>
  <:page_header>
    <div class="space-y-2">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-muted">project</p>
      <h1 class="text-3xl font-semibold">Sprites</h1>
      <p class="text-sm text-muted">
        Sleep-first execution environments scoped to this project.
      </p>
    </div>
  </:page_header>

  <div id="sprites-index-page" class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_20rem]">
    <section class="rounded-box border border-base-300 bg-base-100 p-4 sm:p-6">
      <div class="mb-4 flex items-center justify-between gap-3">
        <h2 class="text-lg font-semibold">Sprites</h2>
        <span class="badge badge-outline">project {@project_id}</span>
      </div>

      <div id="sprites-list" phx-update="stream" class="space-y-3">
        <div class="hidden only:block rounded-box border border-base-300 bg-base-200/70 p-4 text-sm text-muted">
          No sprites in this project yet.
        </div>

        <article
          :for={{dom_id, sprite} <- @streams.sprites}
          id={dom_id}
          class="rounded-box border border-base-300 bg-base-100 p-4"
        >
          <div class="flex items-center justify-between gap-3">
            <div>
              <p class="font-medium text-base-content">{sprite.name}</p>
              <p class="text-xs text-muted">{sprite.remote_name}</p>
            </div>
            <span class="badge badge-ghost">{sprite.status}</span>
          </div>

          <div class="mt-3 flex items-center gap-2">
            <.link
              id={"sprite-open-#{sprite.id}"}
              navigate={~p"/projects/#{@project_id}/sprites/#{sprite.id}"}
              class="btn btn-primary btn-sm"
            >
              Open
            </.link>
            <button
              id={"sprite-delete-#{sprite.id}"}
              type="button"
              class="btn btn-outline btn-error btn-sm"
              phx-click="terminate_sprite"
              phx-value-id={sprite.id}
            >
              Delete
            </button>
          </div>
        </article>
      </div>
    </section>

    <aside class="rounded-box border border-base-300 bg-base-100 p-4 sm:p-6">
      <h2 class="text-lg font-semibold">Create Sprite</h2>
      <p class="mt-1 text-sm text-muted">Provision a new isolated microVM in this project.</p>

      <.form
        for={@create_form}
        id="sprites-create-form"
        phx-change="validate_create_sprite"
        phx-submit="provision_sprite"
        class="mt-4 space-y-4"
      >
        <.input
          field={@create_form[:name]}
          type="text"
          label="Name"
          placeholder="build-agent"
          required
        />

        <button id="sprites-create-submit" type="submit" class="btn btn-primary w-full">
          Create Sprite
        </button>
      </.form>
    </aside>
  </div>
</Layouts.app>

<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  current_path={~p"/workspaces/#{@workspace_id}/sprites/#{@sprite_id}"}
>
  <:page_header>
    <div class="space-y-2">
      <.link
        navigate={~p"/workspaces/#{@workspace_id}/sprites"}
        class="inline-flex items-center gap-2 text-sm text-muted hover:text-base-content"
      >
        <.icon name="hero-arrow-left" class="size-4" /> Back to Sprites
      </.link>
      <h1 class="text-3xl font-semibold">{(@sprite && @sprite.name) || "Sprite"}</h1>
      <p class="text-sm text-muted">Workspace {@workspace_id}</p>
    </div>
  </:page_header>

  <div id="sprite-show-page" class="space-y-6">
    <div class="grid gap-6 xl:grid-cols-2">
      <section class="rounded-box border border-base-300 bg-base-100 p-4 sm:p-6">
        <div class="mb-4 flex items-center justify-between gap-3">
          <h2 class="text-lg font-semibold">Jobs</h2>
          <button id="sprite-refresh-button" class="btn btn-ghost btn-sm" phx-click="refresh">
            Refresh
          </button>
        </div>

        <.form for={@job_form} id="sprite-job-form" phx-submit="enqueue_job" class="space-y-3">
          <.input
            field={@job_form[:command]}
            type="text"
            label="Command"
            placeholder="echo hello"
            required
          />
          <button id="sprite-job-submit" type="submit" class="btn btn-primary btn-sm">
            Run Job
          </button>
        </.form>

        <div id="sprite-jobs" phx-update="stream" class="mt-4 space-y-2">
          <div class="hidden only:block text-sm text-muted">No jobs yet.</div>

          <article
            :for={{dom_id, job} <- @streams.jobs}
            id={dom_id}
            class="rounded-box border border-base-300 p-3"
          >
            <div class="flex items-center justify-between gap-2">
              <p class="font-medium">{job.command}</p>
              <span class="badge badge-outline">{job.state}</span>
            </div>
            <p class="mt-1 text-xs text-muted">{job.inserted_at}</p>
          </article>
        </div>
      </section>

      <section class="rounded-box border border-base-300 bg-base-100 p-4 sm:p-6">
        <div class="mb-4 flex items-center justify-between gap-3">
          <h2 class="text-lg font-semibold">Console</h2>

          <%= if @active_console do %>
            <button
              id="sprite-console-close"
              class="btn btn-error btn-sm"
              phx-click="close_console"
            >
              Close Console
            </button>
          <% else %>
            <button
              id="sprite-console-open"
              class="btn btn-primary btn-sm"
              phx-click="open_console"
            >
              Open Console
            </button>
          <% end %>
        </div>

        <%= if @active_console do %>
          <div
            id="sprite-console"
            phx-hook="SpriteConsole"
            phx-update="ignore"
            data-console-id={@active_console.id}
            class="rounded-box border border-base-300 bg-base-200 p-3"
          >
            <div
              id="sprite-console-output"
              data-console-output
              class="h-72 overflow-hidden rounded-box border border-base-300"
            >
            </div>
          </div>
        <% else %>
          <p class="text-sm text-muted">Open an interactive shell for this sprite.</p>
        <% end %>
      </section>
    </div>

    <div class="grid gap-6 xl:grid-cols-2">
      <section class="rounded-box border border-base-300 bg-base-100 p-4 sm:p-6">
        <h2 class="text-lg font-semibold">Services</h2>

        <div id="sprite-services" phx-update="stream" class="mt-4 space-y-2">
          <div class="hidden only:block text-sm text-muted">No services configured.</div>

          <article
            :for={{dom_id, service} <- @streams.services}
            id={dom_id}
            class="rounded-box border border-base-300 p-3"
          >
            <div class="flex items-center justify-between gap-2">
              <p class="font-medium">{service.name}</p>
              <span class="badge badge-outline">{service.status}</span>
            </div>
            <div class="mt-2 flex items-center gap-2">
              <button
                id={"sprite-service-start-#{service.id}"}
                class="btn btn-primary btn-xs"
                phx-click="start_service"
                phx-value-name={service.name}
              >
                Start
              </button>
              <button
                id={"sprite-service-stop-#{service.id}"}
                class="btn btn-outline btn-xs"
                phx-click="stop_service"
                phx-value-name={service.name}
              >
                Stop
              </button>
            </div>
          </article>
        </div>
      </section>

      <section class="rounded-box border border-base-300 bg-base-100 p-4 sm:p-6">
        <h2 class="text-lg font-semibold">Checkpoints</h2>

        <.form
          for={@checkpoint_form}
          id="sprite-checkpoint-form"
          phx-submit="create_checkpoint"
          class="mt-3 space-y-3"
        >
          <.input
            field={@checkpoint_form[:comment]}
            type="text"
            label="Comment"
            placeholder="before major changes"
          />
          <button id="sprite-checkpoint-submit" type="submit" class="btn btn-primary btn-sm">
            Create Checkpoint
          </button>
        </.form>

        <div id="sprite-checkpoints" phx-update="stream" class="mt-4 space-y-2">
          <div class="hidden only:block text-sm text-muted">No checkpoints available.</div>

          <article
            :for={{dom_id, checkpoint} <- @streams.checkpoints}
            id={dom_id}
            class="rounded-box border border-base-300 p-3"
          >
            <p class="font-medium">{checkpoint.id}</p>
            <p class="text-xs text-muted">{checkpoint.comment}</p>
          </article>
        </div>
      </section>
    </div>
  </div>
</Layouts.app>

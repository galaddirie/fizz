<Layouts.app flash={@flash} current_scope={@current_scope} current_path="/sprites">
  <:page_header>
    <div class="w-full space-y-3">
      <p class="text-xs font-semibold uppercase tracking-[0.3em] text-muted">Compute</p>
      <h1 class="text-3xl font-semibold tracking-tight text-base-content">Workspace Sprites</h1>
      <p class="max-w-3xl text-sm text-muted">
        Manage persistent isolated Sprite environments for this workspace.
      </p>
      <p class="text-xs text-muted">
        Organization: {@organization_id} • Workspace: {@workspace_id}
      </p>
    </div>
  </:page_header>

  <div id="sprite-index-page" class="mx-auto w-full max-w-6xl space-y-6">
    <p
      :if={@sprite_error}
      id="sprite-index-error"
      class="rounded-box border border-error/40 bg-error/10 p-3 text-sm"
    >
      {sprite_error_message(@sprite_error)}
    </p>

    <p
      :if={@sprite_action_error}
      id="sprite-index-action-error"
      class="rounded-box border border-error/40 bg-error/10 p-3 text-sm"
    >
      {sprite_error_message(@sprite_action_error)}
    </p>

    <div
      :if={can_manage_sprites?(@sprite_scope)}
      class="rounded-box border border-base-300 bg-base-100 p-5"
    >
      <h2 class="text-lg font-semibold text-base-content">Create Sprite</h2>
      <.form
        for={@sprite_form}
        id="sprite-create-form"
        phx-change="validate_sprite"
        phx-submit="create_sprite"
        class="mt-4 grid gap-3 md:grid-cols-2"
      >
        <.input field={@sprite_form[:display_name]} type="text" label="Display Name" required />
        <.input field={@sprite_form[:description]} type="text" label="Description" />
        <div class="md:col-span-2">
          <.button id="sprite-create-submit" type="submit">Create Sprite</.button>
        </div>
      </.form>
    </div>

    <div class="rounded-box border border-base-300 bg-base-100">
      <div class="overflow-x-auto">
        <table class="table table-zebra w-full">
          <thead>
            <tr>
              <th>Name</th>
              <th>Sprite Name</th>
              <th>Auth</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody id="sprite-index-list">
            <tr :for={sprite <- @sprites} id={"sprite-row-#{sprite.id}"}>
              <td>
                <div class="flex items-center gap-2">
                  <.link
                    id={"sprite-show-link-#{sprite.id}"}
                    navigate={
                      ~p"/org/#{@organization_id}/workspaces/#{@workspace_id}/sprites/#{sprite.id}"
                    }
                    class="font-medium text-primary hover:underline"
                  >
                    {sprite.display_name}
                  </.link>
                  <span
                    :if={not is_nil(sprite.archived_at)}
                    class="inline-flex rounded-full border border-base-300 bg-base-200 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-muted"
                  >
                    Archived
                  </span>
                </div>
              </td>
              <td class="font-mono text-xs">{sprite.sprite_name}</td>
              <td>{sprite.url_auth_mode}</td>
              <td>
                <div class="flex gap-2">
                  <button
                    :if={can_manage_sprites?(@sprite_scope) and is_nil(sprite.archived_at)}
                    id={"sprite-archive-#{sprite.id}"}
                    phx-click="archive_sprite"
                    phx-value-id={sprite.id}
                    class="btn btn-xs btn-outline"
                    type="button"
                  >
                    Archive
                  </button>
                  <button
                    :if={can_manage_sprites?(@sprite_scope)}
                    id={"sprite-destroy-#{sprite.id}"}
                    phx-click="destroy_sprite"
                    phx-value-id={sprite.id}
                    class="btn btn-xs btn-error btn-outline"
                    type="button"
                  >
                    Destroy
                  </button>
                </div>
              </td>
            </tr>
            <tr :if={@sprites == []} id="sprite-index-empty-row">
              <td colspan="4" class="py-8 text-center text-sm text-muted">No sprites yet.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</Layouts.app>

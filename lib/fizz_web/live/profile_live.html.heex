<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div id="profile-page" class="space-y-8">
    <section id="profile-identifiers" class="rounded-box border border-base-300 bg-base-100 p-6">
      <div class="mb-4">
        <h1 class="text-2xl font-semibold tracking-tight">Profile</h1>
        <p class="text-sm text-base-content/70">
          Inspect your WorkOS identity and manage third-party OAuth connections.
        </p>
      </div>

      <dl class="grid gap-4 sm:grid-cols-2">
        <div
          id="profile-local-user-id"
          class="rounded-box border border-base-300 bg-base-200/50 p-4"
        >
          <dt class="text-xs uppercase tracking-wide text-base-content/60">Local user ID</dt>
          <dd class="mt-2 font-mono text-sm">{@current_scope.user.id}</dd>
        </div>

        <div
          id="profile-workos-user-id"
          class="rounded-box border border-base-300 bg-base-200/50 p-4"
        >
          <dt class="text-xs uppercase tracking-wide text-base-content/60">WorkOS user ID</dt>
          <dd class="mt-2 font-mono text-sm">{@workos_user_id || "Not linked"}</dd>
        </div>

        <div
          id="profile-workos-organization-id"
          class="rounded-box border border-base-300 bg-base-200/50 p-4 sm:col-span-2"
        >
          <dt class="text-xs uppercase tracking-wide text-base-content/60">
            WorkOS organization ID
          </dt>
          <dd class="mt-2 font-mono text-sm">
            {@selected_organization_id || "No WorkOS organization linked"}
          </dd>
        </div>
      </dl>
    </section>

    <section id="profile-pipes" class="rounded-box border border-base-300 bg-base-100 p-6">
      <div class="mb-4 flex flex-col items-start justify-between gap-3 sm:flex-row sm:items-center">
        <div>
          <h2 class="text-xl font-semibold tracking-tight">OAuth Connections</h2>
          <p class="text-sm text-base-content/70">
            Connect and manage your provider accounts through WorkOS Pipes.
          </p>
        </div>
        <.button id="profile-refresh-token-button" phx-click="refresh_pipes_token">
          Refresh Widget Token
        </.button>
      </div>

      <.form
        :if={@organization_options != []}
        for={@org_form}
        id="profile-organization-form"
        phx-change="change_organization"
        class="mb-4 max-w-xl"
      >
        <.input
          field={@org_form[:organization_id]}
          type="select"
          label="Organization"
          options={@organization_options}
        />
      </.form>

      <p
        :if={@organization_options == []}
        id="profile-no-organization"
        class="mb-4 rounded-box border border-warning/40 bg-warning/10 p-3 text-sm"
      >
        No active WorkOS organization memberships were found for this account.
      </p>

      <p
        :if={@pipes_widget_error}
        id="profile-pipes-widget-error"
        class="mb-4 rounded-box border border-error/40 bg-error/10 p-3 text-sm"
      >
        {pipes_widget_error_message(@pipes_widget_error)}
      </p>

      <div
        :if={@pipes_widget_token}
        id={"profile-pipes-widget-#{@selected_organization_id}"}
        phx-hook="PipesWidget"
        phx-update="ignore"
        data-auth-token={@pipes_widget_token}
        class="rounded-box border border-base-300 bg-base-200/40 p-3"
      >
        <div class="rounded-box bg-base-100 p-4 text-sm text-base-content/70">
          Loading Pipes connection manager…
        </div>
      </div>
    </section>
  </div>
</Layouts.app>

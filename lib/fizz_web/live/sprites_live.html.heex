<Layouts.app flash={@flash} current_scope={@current_scope} current_path="/sprites">
  <:page_header>
    <div class="space-y-3">
      <p class="text-xs font-semibold uppercase tracking-[0.32em] text-base-content/50">
        Infrastructure
      </p>
      <h1 class="text-3xl font-semibold tracking-tight">Sprites Broker</h1>
      <p class="max-w-2xl text-sm text-base-content/70">
        Manage per-workspace persistent micro-VMs, run isolated commands, inspect sessions, and restore checkpoints.
      </p>
    </div>
  </:page_header>

  <div
    id="sprites-page"
    class="grid grid-cols-1 gap-6 xl:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)]"
  >
    <section class="space-y-6">
      <div class="rounded-box border border-base-300 bg-base-100 p-5 shadow-sm">
        <div class="mb-4 flex items-center justify-between">
          <h2 class="text-lg font-semibold">Workspace</h2>
          <button
            id="sprites-refresh-workspace"
            type="button"
            class="btn btn-ghost btn-sm"
            phx-click="refresh_workspace"
          >
            Refresh
          </button>
        </div>

        <div
          :if={!@sprites_configured?}
          id="sprites-config-warning"
          class="mb-4 rounded-box border border-warning/40 bg-warning/10 px-4 py-3 text-sm"
        >
          Configure `SPRITES_API_KEY` to enable VM management.
        </div>

        <div
          :if={@workspace_error}
          id="sprites-workspace-error"
          class="mb-4 rounded-box border border-error/40 bg-error/10 px-4 py-3 text-sm"
        >
          {error_message(@workspace_error)}
        </div>

        <div id="sprites-workspace-form" class="grid gap-4 sm:grid-cols-2">
          <div>
            <label class="label" for="sprites-org-select">
              <span class="label-text">Organization</span>
            </label>
            <select
              id="sprites-org-select"
              class="select select-bordered w-full"
              phx-change="select_organization"
              name="organization_id"
            >
              <option :if={@organizations == []} value="">No organizations</option>
              <option
                :for={org <- @organizations}
                value={org.organization_id}
                selected={org.organization_id == @selected_organization_id}
              >
                {org.organization_name}
              </option>
            </select>
          </div>

          <div>
            <label class="label" for="sprites-workspace-select">
              <span class="label-text">Workspace</span>
            </label>
            <select
              id="sprites-workspace-select"
              class="select select-bordered w-full"
              phx-change="select_workspace"
              name="workspace_id"
            >
              <option :if={@workspaces == []} value="">No workspaces</option>
              <option
                :for={ws <- @workspaces}
                value={ws.id}
                selected={ws.id == @selected_workspace_id}
              >
                {ws.name} ({ws.slug})
              </option>
            </select>
          </div>
        </div>

        <div class="mt-4 flex flex-wrap gap-2">
          <button
            id="sprites-ensure-workspace"
            type="button"
            class="btn btn-primary btn-sm"
            phx-click="ensure_sprite"
          >
            Ensure Sprite
          </button>
          <button
            id="sprites-destroy-workspace"
            type="button"
            class="btn btn-outline btn-sm"
            phx-click="destroy_sprite"
          >
            Destroy Sprite
          </button>
        </div>

        <div
          :if={@resolved_scope && @resolved_scope.workspace}
          id="sprites-workspace-details"
          class="mt-4 rounded-box border border-base-300 bg-base-200/60 p-3 text-sm"
        >
          <div class="grid gap-2 sm:grid-cols-2">
            <p class="text-base-content/70">
              Workspace:
              <span class="font-mono text-base-content">{@resolved_scope.workspace.name}</span>
            </p>
            <p class="text-base-content/70">
              Sprite Name:
              <span class="font-mono text-base-content">
                {Fizz.Sprites.workspace_sprite_name(@resolved_scope)}
              </span>
            </p>
          </div>
        </div>
      </div>

      <div class="rounded-box border border-base-300 bg-base-100 p-5 shadow-sm">
        <div class="mb-4 flex items-center justify-between">
          <h2 class="text-lg font-semibold">Command Runner</h2>
          <span id="sprites-last-exit" class="badge badge-outline badge-sm">
            <%= if @last_exec_result do %>
              exit {@last_exec_result.exit_code}
            <% else %>
              idle
            <% end %>
          </span>
        </div>

        <.form for={@exec_form} id="sprites-exec-form" phx-submit="run_exec" class="space-y-3">
          <.input
            field={@exec_form[:command]}
            id="sprites-exec-command"
            type="text"
            label="Shell Command"
            placeholder="python -V"
          />
          <button id="sprites-run-command" type="submit" class="btn btn-primary btn-sm">
            Run In Workspace
          </button>
        </.form>

        <div
          id="sprites-exec-output"
          class="mt-4 rounded-box border border-base-300 bg-base-200/60 p-3"
        >
          <%= if @last_exec_result do %>
            <div class="mb-2 text-xs uppercase tracking-wide text-base-content/50">
              {@last_exec_result.command}
            </div>
            <pre class="max-h-56 overflow-auto whitespace-pre-wrap text-xs leading-relaxed">{@last_exec_result.stdout}</pre>
          <% else %>
            <p class="text-sm text-base-content/60">Run a command to capture output.</p>
          <% end %>
        </div>
      </div>

      <div class="rounded-box border border-base-300 bg-base-100 p-5 shadow-sm">
        <div class="mb-4 flex items-center justify-between">
          <h2 class="text-lg font-semibold">Console</h2>
          <span id="sprites-console-status" class="badge badge-outline badge-sm">
            {@console_status}
          </span>
        </div>

        <div class="mb-4 flex flex-wrap gap-2">
          <button
            id="sprites-open-console"
            type="button"
            class="btn btn-primary btn-sm"
            phx-click="open_console"
          >
            Open Console
          </button>
          <button
            id="sprites-stop-console"
            type="button"
            class="btn btn-outline btn-sm"
            phx-click="stop_console"
          >
            Stop Console
          </button>
          <button
            id="sprites-close-console-stdin"
            type="button"
            class="btn btn-ghost btn-sm"
            phx-click="close_console_stdin"
          >
            Close stdin
          </button>
        </div>

        <.form
          for={@console_input_form}
          id="sprites-console-form"
          phx-submit="console_stdin"
          class="mb-3 flex gap-2"
        >
          <.input
            field={@console_input_form[:input]}
            id="sprites-console-input"
            type="text"
            placeholder="Type command and press Enter"
            class="input input-bordered w-full"
          />
          <button id="sprites-console-send" type="submit" class="btn btn-sm">
            Send
          </button>
        </.form>

        <div
          id="sprites-console-output"
          class="rounded-box border border-base-300 bg-base-300/30 p-3"
        >
          <div
            class="max-h-72 overflow-auto font-mono text-xs leading-relaxed"
            id="sprites-console-stream"
            phx-update="stream"
          >
            <p id="sprites-console-empty" class="hidden only:block text-base-content/50">
              No console output yet.
            </p>
            <p
              :for={{id, entry} <- @streams.console_output}
              id={id}
              class={[
                "mb-1 whitespace-pre-wrap break-words",
                entry.kind == :stderr && "text-warning",
                entry.kind == :error && "text-error",
                entry.kind == :stdin && "text-primary",
                entry.kind == :exit && "text-base-content/70"
              ]}
            >
              {entry.data}
            </p>
          </div>
        </div>

        <p
          :if={@console_attached_session_id}
          id="sprites-attached-session"
          class="mt-3 text-xs text-base-content/60"
        >
          Attached session: <span class="font-mono">{@console_attached_session_id}</span>
        </p>
      </div>
    </section>

    <section class="space-y-6">
      <div class="rounded-box border border-base-300 bg-base-100 p-5 shadow-sm">
        <div class="mb-4 flex items-center justify-between">
          <h2 class="text-lg font-semibold">Organization Sprites</h2>
          <span id="sprites-count" class="badge badge-outline badge-sm">{@sprite_count}</span>
        </div>

        <p
          :if={@sprites_error}
          id="sprites-list-error"
          class="mb-3 rounded-box border border-error/40 bg-error/10 px-3 py-2 text-sm"
        >
          {error_message(@sprites_error)}
        </p>

        <div id="sprites-list" phx-update="stream" class="space-y-2">
          <p
            id="sprites-list-empty"
            class="hidden only:block rounded-box border border-base-300 bg-base-200/50 p-3 text-sm text-base-content/60"
          >
            No sprites found for this organization yet.
          </p>
          <article
            :for={{id, sprite} <- @streams.sprites}
            id={id}
            class="rounded-box border border-base-300 bg-base-200/40 p-3"
          >
            <div class="flex items-start justify-between gap-3">
              <div class="space-y-1">
                <p class="font-mono text-xs sm:text-sm">{sprite.name}</p>
                <p class="text-xs text-base-content/60">status: {sprite.status}</p>
                <p :if={sprite.url} class="text-xs text-base-content/60 break-all">
                  {sprite.url}
                </p>
              </div>
              <span class="badge badge-outline badge-sm">{sprite.auth || "sprite"}</span>
            </div>
          </article>
        </div>
      </div>

      <div class="rounded-box border border-base-300 bg-base-100 p-5 shadow-sm">
        <div class="mb-4 flex items-center justify-between">
          <h2 class="text-lg font-semibold">Sessions</h2>
          <span id="sprites-session-count" class="badge badge-outline badge-sm">
            {@session_count}
          </span>
        </div>

        <p
          :if={@sessions_error}
          id="sprites-sessions-error"
          class="mb-3 rounded-box border border-error/40 bg-error/10 px-3 py-2 text-sm"
        >
          {error_message(@sessions_error)}
        </p>

        <div id="sprites-sessions-list" phx-update="stream" class="space-y-2">
          <p
            id="sprites-sessions-empty"
            class="hidden only:block rounded-box border border-base-300 bg-base-200/50 p-3 text-sm text-base-content/60"
          >
            No active sessions.
          </p>
          <article
            :for={{id, session} <- @streams.sessions}
            id={id}
            class="rounded-box border border-base-300 bg-base-200/40 p-3"
          >
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
              <div class="space-y-1">
                <p class="font-mono text-xs">{session.id}</p>
                <p class="text-xs text-base-content/60">
                  {session.command || "(unknown command)"}
                </p>
                <p class="text-xs text-base-content/60">
                  active: {session.is_active} | tty: {session.tty}
                </p>
              </div>
              <button
                id={"sprites-attach-#{session.id}"}
                type="button"
                class="btn btn-xs"
                phx-click="attach_session"
                phx-value-session-id={session.id}
              >
                Attach
              </button>
            </div>
          </article>
        </div>
      </div>

      <div class="rounded-box border border-base-300 bg-base-100 p-5 shadow-sm">
        <div class="mb-4 flex items-center justify-between">
          <h2 class="text-lg font-semibold">Checkpoints</h2>
          <span id="sprites-checkpoint-count" class="badge badge-outline badge-sm">
            {@checkpoint_count}
          </span>
        </div>

        <p
          :if={@checkpoints_error}
          id="sprites-checkpoints-error"
          class="mb-3 rounded-box border border-error/40 bg-error/10 px-3 py-2 text-sm"
        >
          {error_message(@checkpoints_error)}
        </p>

        <.form
          for={@checkpoint_form}
          id="sprites-checkpoint-form"
          phx-submit="create_checkpoint"
          class="mb-4 space-y-3"
        >
          <.input
            field={@checkpoint_form[:comment]}
            id="sprites-checkpoint-comment"
            type="text"
            label="Create checkpoint"
            placeholder="Before dependency upgrade"
          />
          <button id="sprites-create-checkpoint" type="submit" class="btn btn-sm btn-primary">
            Create
          </button>
        </.form>

        <div id="sprites-checkpoints-list" phx-update="stream" class="space-y-2">
          <p
            id="sprites-checkpoints-empty"
            class="hidden only:block rounded-box border border-base-300 bg-base-200/50 p-3 text-sm text-base-content/60"
          >
            No checkpoints yet.
          </p>
          <article
            :for={{id, checkpoint} <- @streams.checkpoints}
            id={id}
            class="rounded-box border border-base-300 bg-base-200/40 p-3"
          >
            <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
              <div class="space-y-1">
                <p class="font-mono text-xs">{checkpoint.id}</p>
                <p class="text-xs text-base-content/60">{checkpoint.comment || "No comment"}</p>
                <p class="text-xs text-base-content/60">
                  {checkpoint.create_time || "unknown timestamp"}
                </p>
              </div>
              <button
                id={"sprites-restore-#{checkpoint.id}"}
                type="button"
                class="btn btn-xs"
                phx-click="restore_checkpoint"
                phx-value-checkpoint-id={checkpoint.id}
              >
                Restore
              </button>
            </div>
          </article>
        </div>

        <div
          :if={@latest_checkpoint_messages != []}
          id="sprites-checkpoint-messages"
          class="mt-4 rounded-box border border-base-300 bg-base-200/50 p-3"
        >
          <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-base-content/60">
            Latest checkpoint operation
          </p>
          <pre class="max-h-40 overflow-auto whitespace-pre-wrap text-xs leading-relaxed">{inspect(@latest_checkpoint_messages, pretty: true)}</pre>
        </div>
      </div>
    </section>
  </div>
</Layouts.app>
